	"context_servers": {},
	"agent_servers": {
		"opencode": {
			"type": "registry",
		},
	},
	"edit_predictions": {
		"mode": "subtle",
	},
	"hover_popover_enabled": true,
	"use_system_path_prompts": false,
	"agent": {
		"tool_permissions": {
			"tools": {
				"fetch": {
					"default": "allow",
				},
				"terminal": {
					"default": "allow",
				},
				"mcp:mcp-server-context7:query-docs": {
					"default": "allow",
				},
				"mcp:mcp-server-context7:resolve-library-id": {
					"default": "allow",
				},
			},
		},
		"inline_assistant_model": {
			"provider": "google",
			"model": "gemini-3-flash-preview",
			"enable_thinking": false,
		},
		"default_model": {
			"provider": "Pioneer",
			"model": "claude-opus-4-7",
			"enable_thinking": false,
		},
		"favorite_models": [],
		"play_sound_when_agent_done": "always",
		"model_parameters": [],
	},
	"window_decorations": "server",
	"tabs": {
		"file_icons": true,
		"git_status": false,
	},
	"title_bar": {
		"show_branch_status_icon": true,
	},
	"diagnostics": {
		"inline": {
			"enabled": true,
		},
	},
	"code_lens": "on",
	"semantic_tokens": "combined",
	"document_symbols": "on",
	"colorize_brackets": true,
	"inlay_hints": {
		"enabled": true,
	},
	"indent_guides": {
		"background_coloring": "indent_aware",
		"coloring": "indent_aware",
	},
	"preferred_line_length": 80,
	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"vim": {
		"use_system_clipboard": "on_yank",
		"cursor_shape": {
			"visual": "hollow",
		},
		"highlight_on_yank_duration": 201,
		"use_smartcase_find": false,
		"toggle_relative_line_numbers": true,
	},
	"toolbar": {
		"code_actions": true,
	},
	"minimap": {
		"show": "auto",
	},
	"relative_line_numbers": "enabled",
	"drag_and_drop_selection": {
		"delay": 200,
	},
	"hover_popover_delay": 200,
	"show_signature_help_after_edits": true,
	"auto_signature_help": true,
	"autoscroll_on_clicks": true,
	"sticky_scroll": {
		"enabled": true,
	},
	"which_key": {
		"delay_ms": 0,
		"enabled": true,
	},
	"autosave": "on_focus_change",
	"unnecessary_code_fade": 0.4,
	"multi_cursor_modifier": "cmd_or_ctrl",
	"text_rendering_mode": "subpixel",
	"ui_font_weight": 400.0,
	"ui_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"use_system_prompts": false,
	"when_closing_with_no_tabs": "keep_window_open",
	"vim_mode": true,
	"icon_theme": {
		"mode": "light",
		"light": "Zed (Default)",
		"dark": "Catppuccin Mocha",
	},
	"ui_font_size": 16.0,
	"buffer_font_size": 16,
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Catppuccin Mocha",
	},
	"node": {
		"npm_path": "/usr/bin/bun",
	},
	"auto_install_extensions": {
		"hackatime": true
	},
}
